# Gemini Live Voice Assistant Configuration (Server-Side Only)
# WARNING: NEVER prefix with VITE_ to prevent leaking the secret to the browser client.
# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Live Model Target (default: gemini-3.8-live; dynamic fallback: gemini-3.1-flash-live-preview)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Business Data Provider Configuration
# Set to 'mock_authoritative' for local verified data with live sync testing,
# or provide external CRM/ERP webhook/endpoint when available.
BUSINESS_DATA_MODE=mock_authoritative

# Exotel Telephony API Configuration (Server-Side Only)
# WARNING: NEVER prefix with VITE_ to prevent leaking credentials to browser client.
# Account SID: As displayed in your Exotel dashboard
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here

# API Key & Token: Generate under API Settings
# Note: The entry name is NOT the API key. Use the 32-char hex key and token.
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here

# API Subdomain: api.exotel.com (Singapore cluster) or api.in.exotel.com (Mumbai cluster)
EXOTEL_SUBDOMAIN=your_exotel_subdomain_here

# Caller ID: Verified Account Virtual Number / ExoPhone (e.g. your_virtual_exophone_number)
# Note: Do NOT use shared trial pool numbers or personal registration PIN.
EXOTEL_CALLER_ID=your_verified_exophone_number_here

# Employee Phone: The frontline agent physical mobile number to receive Leg A (e.g. +91XXXXXXXXXX)
# Used ONLY in Mode 1 (Call Myself). Never dialed in Mode 2 (Call Using AI Agent).
EXOTEL_AGENT_PHONE=your_employee_phone_number_here

# Mode 2: Exotel Connect Voice AI / Voicebot WebSocket Stream Configuration (Server-Side Only)
# EXOTEL_STREAM_URL: Public WSS endpoint where Exotel connects the bidirectional audio stream
# Example for local development with ngrok: wss://your-ngrok-subdomain.ngrok-free.app/exotel-voicebot
# Example for production server: wss://callcentre-voicebot.yourdomain.com/exotel-voicebot
EXOTEL_STREAM_URL=wss://your_public_domain_here/exotel-voicebot

# Public Host for dynamic session callback URL resolution
EXOTEL_STREAM_HOST=your_public_domain_here


