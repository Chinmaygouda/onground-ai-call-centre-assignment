# Gemini Live Voice Assistant Configuration (Server-Side Only)
# WARNING: NEVER prefix with VITE_ to prevent leaking the secret to the browser client.
# Obtain your Gemini API Key from Google AI Studio: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here

# Live Model Target (default: gemini-3.8-live; dynamic fallback: gemini-3.1-flash-live-preview)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Business Data Provider Configuration
# Set to 'mock_authoritative' for local verified data with live sync testing,
# or provide external CRM/ERP webhook/endpoint when available.
BUSINESS_DATA_MODE=mock_authoritative

# Exotel Telephony API Configuration (Server-Side Only)
# WARNING: NEVER prefix with VITE_ to prevent leaking the secret to the browser client.
# Obtain your API Key, Token, and Account SID from the Exotel Dashboard: https://my.exotel.com/
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=your_exotel_virtual_number_here
EXOTEL_AGENT_PHONE=your_employee_phone_number_here
